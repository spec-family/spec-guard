{
  "name": "@spec-family/spec-guard",
  "version": "0.33.1",
  "mcpName": "io.github.spec-family/spec-guard",
  "description": "Hold your code to what your Markdown says about it: the claims specs, ADRs, READMEs and agent instructions make about your codebase, as assertions that run in CI.",
  "keywords": [
    "adr",
    "agents",
    "architecture",
    "claims",
    "documentation",
    "drift",
    "lint",
    "markdown",
    "mcp",
    "ripgrep",
    "spec"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spec-guard": "bin/spec-guard.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src/vendor/spec-core/LICENSE",
    "CHANGELOG.md",
    "/README.md",
    "docs/reference",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "selfcheck": "node ./bin/spec-guard.js --verbose",
    "prepublishOnly": "node -e \"if (process.env.GITHUB_ACTIONS !== 'true') { console.error('npm publish is refused outside GitHub Actions: a release is a v* tag, staged by CI with provenance.'); process.exit(1) }\" && npm run clean && npm run build"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/ripgrep": "^1.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spec-family/spec-guard.git"
  },
  "bugs": {
    "url": "https://github.com/spec-family/spec-guard/issues"
  },
  "homepage": "https://github.com/spec-family/spec-guard#readme",
  "specGuard": {
    "specs": [
      "docs/**/*.md",
      "README.md"
    ],
    "exclude": [
      "dist",
      "coverage",
      "reports",
      "tests/fixtures"
    ]
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
